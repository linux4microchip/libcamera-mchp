module ipa.microchip_isc;

import "include/libcamera/ipa/core.mojom";

/*
 * Hardware capability flags detected by the pipeline handler and forwarded
 * to the IPA at init()/configure() time. These reflect silicon-level features
 * of the ISC variant (SAMA5D2 ISC vs. SAMA7G5/SAM9X7 XISC) and must not be
 * duplicated in sensor-specific YAML tuning files.
 */
struct IPAHwCapabilities {
	/* SAMA7G5/SAM9X7 only: DPC block subtracts black level before WB. */
	bool hasDpc;
	/* SAMA7G5/SAM9X7 only: GAM block supports linear-toe bipartite mode. */
	bool hasBipartiteGamma;
	/* SAMA7G5/SAM9X7 only: CBHS block adds Saturation and Hue controls. */
	bool hasCbhs;
	/* True when the ISC stats node was opened and histogram data is valid. */
	bool statsAvailable;
};

struct IPAConfigInfo {
	libcamera.IPACameraSensorInfo sensorInfo;
	libcamera.ControlInfoMap sensorControls;
	/*
	 * Live sensor controls read immediately after sensor_->setFormat() so
	 * the IPA can compute lineDuration from the CURRENT hblank for the
	 * active sensor mode rather than from the ControlInfoMap default.
	 * Different sensor modes (e.g. 1920x1080 vs 3264x2464) have different
	 * hblank values; using the default gives an incorrect lineDuration and
	 * therefore wrong maxShutterSpeed, causing over/underexposure at
	 * non-default sensor modes.
	 */
	libcamera.ControlList sensorLiveControls;
	/*
	 * Native sensor output width for the active mode — the hardware pixel
	 * count per line including any overscan (e.g. 3280 for IMX219 at max
	 * resolution, vs the capture-clamped 3264). Used with the live hblank
	 * to compute the accurate line duration for every supported mode.
	 */
	uint32 nativeSensorWidth;
	libcamera.ControlInfoMap ispControls;
	IPAHwCapabilities hwCaps;
};

interface IPAMicrochipISCInterface {
	init(libcamera.IPASettings settings, IPAConfigInfo configInfo)
		=> (int32 ret, libcamera.ControlInfoMap ipaControls);
	start() => (int32 ret);
	stop();

	configure(IPAConfigInfo configInfo, uint8 bayerOrder)
		=> (int32 ret, libcamera.ControlInfoMap ipaControls);

	mapBuffers(array<libcamera.IPABuffer> buffers);
	unmapBuffers(array<uint32> ids);

	[async] queueRequest(uint32 request, libcamera.ControlList reqControls);
	[async] processStats(uint32 request, uint32 bufferId,
			     libcamera.ControlList sensorControls);
};

interface IPAMicrochipISCEventInterface {
	statsProcessed(uint32 request, libcamera.ControlList metadata);
	setSensorControls(libcamera.ControlList sensorControls);
	setIspControls(libcamera.ControlList ispControls);
};
